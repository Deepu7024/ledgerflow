# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Create React App) ---
frontend/node_modules
frontend/.pnp
frontend/.pnp.js
frontend/coverage
frontend/build
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- backend (FastAPI) ---
backend/.venv
backend/venv
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/.env
backend/credentials.json
backend/token.json
# Google's default download name for OAuth client secrets — catch it
# anywhere under backend/ in case it lands somewhere other than
# backend/credentials.json before being renamed.
backend/**/client_secret_*.json

# --- misc ---
.DS_Store
